# ─────────────────────────────────────────────────────────────────────────────
# Project Jackpot - configuration contract
#
# Copy to .env for local development. NEVER commit a filled-in .env:
# every value below is read from the environment, and secrets belong in the
# hosting platform's variable store (Constitution, Principle IV).
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# development | test | production
ENVIRONMENT=development
PORT=9600

# ── Database ─────────────────────────────────────────────────────────────────
# In production the platform injects DATABASE_URL; leave it empty locally and
# the discrete values below are used instead.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=project_jackpot_db

# ── AI provider ──────────────────────────────────────────────────────────────
# auto     -> groq when GROQ_API_KEY is set, otherwise the deterministic stub
# groq     -> production (free tier, OpenAI-compatible)
# ollama   -> local development (needs the Ollama daemon)
# lmstudio -> local desktop
# stub     -> deterministic, no network, no credentials
AI_PROVIDER=auto

# Get a free key at https://console.groq.com - keep it OUT of source control.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:E2B

# ── Security ─────────────────────────────────────────────────────────────────
# Explicit allow-list, comma separated. "*" makes the app refuse to start in
# production, on purpose.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=65536

# ── Logging ──────────────────────────────────────────────────────────────────
ENABLE_LOGS=true
LOG_LEVEL=INFO
